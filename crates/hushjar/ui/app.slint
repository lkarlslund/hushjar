import { Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton } from "widgets.slint";
import { VaultTree } from "tree.slint";
import { DetailsPane } from "details.slint";
import {
    AccountBadge, DetailField, DetailSection, FieldKind, GroupSummary, ItemHeader, PaneMode, RowIcon,
    RowKind, TreeRow,
} from "types.slint";

export {
    AccountBadge, DetailField, DetailSection, FieldKind, GroupSummary, ItemHeader, PaneMode, RowIcon,
    RowKind, TreeRow, Palette,
}

component TopBar inherits Rectangle {
    in property <string> sync-text;
    in property <bool> sidebar-visible;
    callback toggle-sidebar();
    callback sync();
    callback new-item();
    callback generator();
    callback send();
    callback settings();
    callback lock-all();

    height: 44px;
    background: Theme.sidebar;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 4px;

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.sidebar;
                label: root.sidebar-visible ? "Hide sidebar" : "Show sidebar";
                active: !root.sidebar-visible;
                clicked => { root.toggle-sidebar(); }
            }
        }
        Rectangle { width: 4px; }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.jar; width: 20px; height: 20px; tint: Theme.honey; }
        }
        Text {
            text: "Hushjar";
            vertical-alignment: center;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
        }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: root.sync-text;
            vertical-alignment: center;
            font-size: Theme.small;
            color: Theme.faint;
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.sync; label: "Sync now (Ctrl+R)"; clicked => { root.sync(); } }
        }
        Rectangle { width: 6px; }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: "New";
                primary: true;
                has-icon: true;
                icon: Icons.plus;
                clicked => { root.new-item(); }
            }
        }
        Rectangle { width: 6px; }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.dice; label: "Generator (Ctrl+G)"; clicked => { root.generator(); } }
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.send; label: "Send"; clicked => { root.send(); } }
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.settings; label: "Settings"; clicked => { root.settings(); } }
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.lock; label: "Lock all (Ctrl+L)"; clicked => { root.lock-all(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: "Hushjar";
    icon: @image-url("icons/jar.svg");
    preferred-width: 1180px;
    preferred-height: 740px;
    min-width: 720px;
    min-height: 360px;
    background: Theme.window;
    default-font-size: Theme.body;

    // Tree
    in property <[TreeRow]> rows;
    in property <string> selected-key;
    in property <int> selected-index: -1;
    in property <int> match-count;
    in property <int> group-by;
    in-out property <string> filter-text;

    // Details
    in property <PaneMode> mode;
    in property <ItemHeader> header;
    in property <[DetailSection]> sections;
    in property <bool> editing;
    in property <bool> dirty;
    in property <bool> leave-pending;
    in property <int> totp-remaining;
    in property <[string]> folders;
    in property <int> folder-index;
    in property <AccountBadge> account;
    in property <string> unlock-error;
    in property <GroupSummary> group;
    in property <int> unlock-focus-request;

    in property <string> sync-text;
    in property <string> toast;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 320px;

    callback filter-edited(string);
    callback filter-accepted();
    callback group-by-picked(int);
    callback row-clicked(string);
    callback row-toggled(string);
    callback row-activated(string);
    callback move-selection(int);
    callback expand-selection();
    callback collapse-selection();
    callback activate-selection();
    callback add-account();

    callback copy-field(int, int);
    callback copy-shortcut(string);
    callback open-url(string);
    callback begin-edit();
    callback save();
    callback cancel();
    callback discard-and-leave();
    callback keep-editing();
    callback save-and-leave();
    callback edit-field(int, int, string);
    callback edit-label(int, int, string);
    callback edit-name(string);
    callback toggle-favorite();
    callback pick-folder(int);
    callback generate(int, int);
    callback add-field(int);
    callback remove-field(int, int);
    callback delete-item();
    callback restore-item();
    callback unlock(string);

    callback sync();
    callback new-item();
    callback not-yet(string);
    callback lock-all();

    // The prototype uses Slint's own clipboard support through a hidden text
    // field. Real clipboard handling, with clearing and password hints, comes in M3.
    public function copy-text(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    public function focus-tree() {
        tree.focus-tree();
    }

    clip := TextInput {
        visible: false;
        width: 0;
        height: 0;
    }

    scope := FocusScope {
        KeyBinding { keys: @keys(Control + F); activated => { root.sidebar-visible = true; tree.focus-filter(); } }
        KeyBinding { keys: @keys(Control + E); activated => { root.begin-edit(); } }
        KeyBinding { keys: @keys(Control + S); activated => { root.save(); } }
        KeyBinding { keys: @keys(Control + N); activated => { root.new-item(); } }
        KeyBinding { keys: @keys(Control + L); activated => { root.lock-all(); } }
        KeyBinding { keys: @keys(Control + R); activated => { root.sync(); } }
        KeyBinding { keys: @keys(Control + G); activated => { root.not-yet("The generator"); } }
        KeyBinding { keys: @keys(Control + U); activated => { root.copy-shortcut("username"); } }
        KeyBinding { keys: @keys(Control + P); activated => { root.copy-shortcut("password"); } }
        KeyBinding { keys: @keys(Control + T); activated => { root.copy-shortcut("code"); } }
        KeyBinding { keys: @keys(Control + B); activated => { root.sidebar-visible = !root.sidebar-visible; } }
        KeyBinding { keys: @keys(Escape); enabled: root.editing; activated => { root.cancel(); } }

        VerticalLayout {
            TopBar {
                sync-text: root.sync-text;
                sidebar-visible: root.sidebar-visible;
                toggle-sidebar => { root.sidebar-visible = !root.sidebar-visible; }
                sync => { root.sync(); }
                new-item => { root.new-item(); }
                generator => { root.not-yet("The generator"); }
                send => { root.not-yet("Send"); }
                settings => { root.not-yet("Settings"); }
                lock-all => { root.lock-all(); }
            }

            HorizontalLayout {
                vertical-stretch: 1;

                tree := VaultTree {
                    visible: root.sidebar-visible;
                    width: root.sidebar-visible ? root.sidebar-width : 0px;
                    rows: root.rows;
                    selected-key: root.selected-key;
                    selected-index: root.selected-index;
                    match-count: root.match-count;
                    group-by: root.group-by;
                    filter-text <=> root.filter-text;
                    filter-edited(text) => { root.filter-edited(text); }
                    filter-accepted => { root.filter-accepted(); }
                    group-by-picked(index) => { root.group-by-picked(index); }
                    row-clicked(key) => { root.row-clicked(key); }
                    row-toggled(key) => { root.row-toggled(key); }
                    row-activated(key) => { root.row-activated(key); }
                    move-selection(delta) => { root.move-selection(delta); }
                    expand-selection => { root.expand-selection(); }
                    collapse-selection => { root.collapse-selection(); }
                    activate-selection => { root.activate-selection(); }
                    add-account => { root.add-account(); }
                }

                // Draggable divider
                if root.sidebar-visible: Rectangle {
                    width: 1px;
                    background: Theme.border;
                    divider := TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            root.sidebar-width = max(220px, min(root.width - 380px, root.sidebar-width + self.mouse-x - self.pressed-x));
                        }
                    }
                }

                DetailsPane {
                    horizontal-stretch: 1;
                    mode: root.mode;
                    header: root.header;
                    sections: root.sections;
                    editing: root.editing;
                    dirty: root.dirty;
                    leave-pending: root.leave-pending;
                    totp-remaining: root.totp-remaining;
                    folders: root.folders;
                    folder-index: root.folder-index;
                    account: root.account;
                    unlock-error: root.unlock-error;
                    group: root.group;
                    unlock-focus-request: root.unlock-focus-request;
                    copy-field(s, f) => { root.copy-field(s, f); }
                    open-url(url) => { root.open-url(url); }
                    begin-edit => { root.begin-edit(); }
                    save => { root.save(); }
                    cancel => { root.cancel(); }
                    discard-and-leave => { root.discard-and-leave(); }
                    keep-editing => { root.keep-editing(); }
                    save-and-leave => { root.save-and-leave(); }
                    edit-field(s, f, text) => { root.edit-field(s, f, text); }
                    edit-label(s, f, text) => { root.edit-label(s, f, text); }
                    edit-name(text) => { root.edit-name(text); }
                    toggle-favorite => { root.toggle-favorite(); }
                    pick-folder(index) => { root.pick-folder(index); }
                    generate(s, f) => { root.generate(s, f); }
                    add-field(s) => { root.add-field(s); }
                    remove-field(s, f) => { root.remove-field(s, f); }
                    delete-item => { root.delete-item(); }
                    restore-item => { root.restore-item(); }
                    unlock(password) => { root.unlock(password); }
                }
            }
        }
    }

    // Toast
    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        width: toast-text.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: Theme.dark ? #f1efe9 : #26272d;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        toast-text := Text {
            text: root.toast;
            color: Theme.dark ? #1d1c1a : #f1efe9;
            font-size: Theme.body;
            accessible-role: text;
        }
    }

    init => { scope.focus(); }
}
