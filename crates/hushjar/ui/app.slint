import { Palette } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Icon, IconButton, ActionButton } from "widgets.slint";
import { VaultTree } from "tree.slint";
import { DetailsPane } from "details.slint";
import { SettingsData, AccountSecurity } from "settings.slint";
import { GeneratorData, GeneratedValue } from "generator.slint";
import { SignInData, UnlockData, AccountData, LoginRequestData, LoginRequestBanner } from "access.slint";
import { TransferData } from "transfer.slint";
import { ItemExtras, MenuEntry, AttachmentRow, PasskeyRow, CollectionChoice } from "item-extras.slint";
import { SendsData, SendRow } from "sends.slint";
import {
    AccountBadge, AccountSummary, DetailField, DetailSection, FieldKind, GroupSummary, ItemHeader, PaneMode,
    RowIcon, RowKind, SignInForm, TreeRow, Platform,
} from "types.slint";

export {
    AccountBadge, AccountSummary, DetailField, DetailSection, FieldKind, GroupSummary, ItemHeader, PaneMode,
    RowIcon, RowKind, SignInForm, TreeRow, Palette, SettingsData, AccountSecurity, GeneratorData, GeneratedValue, TransferData,
    ItemExtras, MenuEntry, AttachmentRow, PasskeyRow, CollectionChoice,
    SendsData, SendRow, Platform,
}

// One entry of the top bar's overflow menu.
component TopMenuEntry inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    callback clicked;

    height: 40px;
    border-radius: 4px;
    background: touch.pressed ? Theme.pressed : touch.has-hover ? Theme.hover : transparent;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon { source: root.icon; }
        }
        Text {
            text: root.text;
            vertical-alignment: center;
            color: Theme.text;
            overflow: elide;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}
export { SignInData, UnlockData, AccountData, LoginRequestData }

component TopBar inherits Rectangle {
    in property <string> sync-text;
    in property <bool> sidebar-visible;
    callback toggle-sidebar();
    callback sync();
    callback new-item();
    callback generator();
    callback send();
    callback transfer();
    callback settings();
    callback lock-all();
    callback agent-clicked();
    in property <bool> agent-running;
    in property <int> agent-keys;
    // Narrow window: one pane at a time, secondary buttons in a menu.
    in property <bool> compact;
    // In compact mode, whether the details pane is shown (so Back is offered).
    in property <bool> details-open;
    callback back();

    property <string> agent-label: root.agent-running
        ? "SSH agent: " + root.agent-keys + " keys offered"
        : "SSH agent is not running";

    height: 44px;
    background: Theme.sidebar;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    // Placed explicitly so the buttons do not set the window's minimum
    // width: which buttons show depends on the width (compact).
    HorizontalLayout {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        padding-left: 8px;
        padding-right: 10px;
        spacing: 4px;

        if !root.compact: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.sidebar;
                label: root.sidebar-visible ? "Hide sidebar" : "Show sidebar";
                active: !root.sidebar-visible;
                clicked => { root.toggle-sidebar(); }
            }
        }
        if root.compact && root.details-open: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.back;
                label: "Back";
                size: 36px;
                clicked => { root.back(); }
            }
        }
        Rectangle { width: 4px; }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.jar; width: 20px; height: 20px; tint: Theme.honey; }
        }
        Text {
            text: "Hushjar";
            vertical-alignment: center;
            font-size: 15px;
            font-weight: 700;
            color: Theme.text;
        }
        Rectangle { horizontal-stretch: 1; }
        if !root.compact: Text {
            text: root.sync-text;
            vertical-alignment: center;
            font-size: Theme.small;
            color: Theme.faint;
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.sync; label: "Sync now (Ctrl+R)"; clicked => { root.sync(); } }
        }
        Rectangle { width: 6px; }
        VerticalLayout {
            alignment: center;
            ActionButton {
                text: "New";
                primary: true;
                has-icon: true;
                icon: Icons.plus;
                clicked => { root.new-item(); }
            }
        }
        Rectangle { width: 6px; }
        if !root.compact && Platform.ssh-agent: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.terminal;
                label: root.agent-label;
                active: root.agent-running && root.agent-keys > 0;
                clicked => { root.agent-clicked(); }
            }
        }
        if !root.compact: VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.dice; label: "Generator (Ctrl+G)"; clicked => { root.generator(); } }
        }
        if !root.compact: VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.send; label: "Send"; clicked => { root.send(); } }
        }
        if !root.compact: VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.transfer; label: "Import and export"; clicked => { root.transfer(); } }
        }
        if !root.compact: VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.settings; label: "Settings"; clicked => { root.settings(); } }
        }
        VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.lock; label: "Lock all (Ctrl+L)"; clicked => { root.lock-all(); } }
        }
        if root.compact: VerticalLayout {
            alignment: center;
            IconButton { icon: Icons.more; label: "More"; clicked => { menu.show(); } }
        }
    }

    menu := PopupWindow {
        x: root.width - self.width - 6px;
        y: root.height - 2px;
        width: 230px;
        Rectangle {
            background: Theme.surface;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 10px;
            drop-shadow-color: #00000033;
            VerticalLayout {
                padding: 4px;
                TopMenuEntry { icon: Icons.dice; text: "Generator"; clicked => { menu.close(); root.generator(); } }
                TopMenuEntry { icon: Icons.send; text: "Send"; clicked => { menu.close(); root.send(); } }
                TopMenuEntry { icon: Icons.transfer; text: "Import and export"; clicked => { menu.close(); root.transfer(); } }
                TopMenuEntry { icon: Icons.settings; text: "Settings"; clicked => { menu.close(); root.settings(); } }
                if Platform.ssh-agent: TopMenuEntry {
                    icon: Icons.terminal;
                    text: root.agent-label;
                    clicked => { menu.close(); root.agent-clicked(); }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "Hushjar";
    icon: @image-url("icons/jar.svg");
    preferred-width: 1180px;
    preferred-height: 740px;
    // Below the compact width the window shows one pane at a time.
    min-width: 360px;
    min-height: 360px;
    background: Theme.window;
    default-font-size: Theme.body;

    // Tree
    in property <[TreeRow]> rows;
    in property <string> selected-key;
    in property <int> selected-index: -1;
    in property <int> match-count;
    in property <int> group-by;
    in-out property <string> filter-text;

    // Details
    in property <PaneMode> mode;
    in property <ItemHeader> header;
    in property <[DetailSection]> sections;
    in property <bool> editing;
    in property <bool> dirty;
    in property <bool> leave-pending;
    in property <int> totp-remaining;
    in property <[string]> folders;
    in property <int> folder-index;
    in property <AccountBadge> account;
    in property <string> unlock-error;
    in property <GroupSummary> group;
    in property <int> unlock-focus-request;
    in property <SignInForm> sign-in;
    in property <AccountSummary> summary;
    in property <bool> busy;
    in property <[string]> item-types;
    in property <int> type-index;

    in property <string> sync-text;
    in property <string> toast;
    in property <string> ssh-prompt;
    in property <bool> agent-running;
    in property <int> agent-keys;
    in property <bool> ssh-visible;
    in property <bool> ssh-enabled;
    in property <int> ssh-mode;
    in-out property <bool> sidebar-visible: true;
    in-out property <length> sidebar-width: 320px;
    // Narrow windows (phones) show either the tree or the details pane.
    out property <bool> compact: root.width < 640px;
    // In compact mode, whether the details pane replaces the tree.
    in-out property <bool> details-open;

    callback filter-edited(string);
    callback filter-accepted();
    callback group-by-picked(int);
    callback row-clicked(string);
    callback row-toggled(string);
    callback row-activated(string);
    callback move-selection(int);
    callback expand-selection();
    callback collapse-selection();
    callback activate-selection();
    callback add-account();

    callback copy-field(int, int);
    callback copy-shortcut(string);
    callback open-url(string);
    callback begin-edit();
    callback save();
    callback cancel();
    callback discard-and-leave();
    callback keep-editing();
    callback save-and-leave();
    callback edit-field(int, int, string);
    callback edit-label(int, int, string);
    callback edit-name(string);
    callback toggle-favorite();
    callback pick-folder(int);
    callback generate(int, int);
    callback add-field(int);
    callback remove-field(int, int);
    callback delete-item();
    callback restore-item();
    callback unlock(string);
    callback pick-type(int);
    callback create-folder(string);
    callback sign-in-submit(int, string, string, string);
    callback sign-in-code(int, string, bool);
    callback sign-in-email(int);
    callback sign-in-cancel();
    callback account-sync();
    callback account-lock();
    callback account-remove();
    callback account-reconnect(string, string, bool);
    // Any key press or click, for the inactivity lock.
    callback activity();
    callback ssh-answer(bool);
    callback agent-clicked();
    callback ssh-toggle(bool);
    callback ssh-mode-picked(int);

    callback sync();
    callback new-item();
    callback not-yet(string);
    callback open-settings();
    callback open-generator();
    callback open-sends();
    callback open-transfer();
    callback lock-all();

    public function focus-tree() {
        tree.focus-tree();
        root.details-open = false;
    }

    // Shows the details pane when one pane is shown at a time. The hidden
    // tree would keep the keyboard focus, and hidden elements get no keys,
    // so the window's own scope takes it: Back must keep working.
    function open-details() {
        root.details-open = true;
        if (root.compact) {
            scope.focus();
        }
    }

    // Copies through Slint's own clipboard, which Android needs because it
    // has no clipboard crate (see clipboard.rs). The text leaves the hidden
    // input right after.
    public function copy-to-clipboard(text: string) {
        clip.text = text;
        clip.select-all();
        clip.copy();
        clip.text = "";
    }

    scope := FocusScope {
        capture-key-pressed(event) => {
            root.activity();
            // Android's Back key returns from the details to the tree.
            if (event.text == Key.Back && root.compact && root.details-open) {
                root.focus-tree();
                return accept;
            }
            reject
        }
        KeyBinding { keys: @keys(Control + F); activated => { root.sidebar-visible = true; tree.focus-filter(); } }
        KeyBinding { keys: @keys(Control + E); activated => { root.begin-edit(); } }
        KeyBinding { keys: @keys(Control + S); activated => { root.save(); } }
        KeyBinding { keys: @keys(Control + N); activated => { root.open-details(); root.new-item(); } }
        KeyBinding { keys: @keys(Control + L); activated => { root.lock-all(); } }
        KeyBinding { keys: @keys(Control + R); activated => { root.sync(); } }
        KeyBinding { keys: @keys(Control + G); activated => { root.open-details(); root.open-generator(); } }
        KeyBinding { keys: @keys(Control + U); activated => { root.copy-shortcut("username"); } }
        KeyBinding { keys: @keys(Control + P); activated => { root.copy-shortcut("password"); } }
        KeyBinding { keys: @keys(Control + T); activated => { root.copy-shortcut("code"); } }
        KeyBinding { keys: @keys(Control + B); activated => { root.sidebar-visible = !root.sidebar-visible; } }
        KeyBinding { keys: @keys(Escape); enabled: root.editing; activated => { root.cancel(); } }

        VerticalLayout {
            // Phones draw under the status and navigation bars.
            padding-top: root.safe-area-insets.top;
            padding-bottom: root.safe-area-insets.bottom;
            padding-left: root.safe-area-insets.left;
            padding-right: root.safe-area-insets.right;

            TopBar {
                sync-text: root.sync-text;
                sidebar-visible: root.sidebar-visible;
                compact: root.compact;
                details-open: root.details-open;
                back => { root.focus-tree(); }
                toggle-sidebar => { root.sidebar-visible = !root.sidebar-visible; }
                sync => { root.sync(); }
                new-item => { root.open-details(); root.new-item(); }
                generator => { root.open-details(); root.open-generator(); }
                send => { root.open-details(); root.open-sends(); }
                transfer => { root.open-details(); root.open-transfer(); }
                settings => { root.open-details(); root.open-settings(); }
                lock-all => { root.details-open = false; root.lock-all(); }
                agent-running: root.agent-running;
                agent-keys: root.agent-keys;
                agent-clicked => { root.agent-clicked(); }
            }

            // The panes are placed by hand rather than by a layout, so that
            // compact mode can give either one the full width while both
            // keep their state (scroll position, edits) when hidden.
            body := Rectangle {
                vertical-stretch: 1;

                tree := VaultTree {
                    x: 0;
                    y: 0;
                    height: parent.height;
                    visible: root.compact ? !root.details-open : root.sidebar-visible;
                    width: root.compact
                        ? (root.details-open ? 0px : parent.width)
                        : (root.sidebar-visible ? root.sidebar-width : 0px);
                    compact: root.compact;
                    opened => { root.open-details(); }
                    rows: root.rows;
                    selected-key: root.selected-key;
                    selected-index: root.selected-index;
                    match-count: root.match-count;
                    group-by: root.group-by;
                    filter-text <=> root.filter-text;
                    filter-edited(text) => { root.filter-edited(text); }
                    filter-accepted => { root.filter-accepted(); }
                    group-by-picked(index) => { root.group-by-picked(index); }
                    row-clicked(key) => { root.row-clicked(key); }
                    row-toggled(key) => { root.row-toggled(key); }
                    row-activated(key) => { root.row-activated(key); }
                    move-selection(delta) => { root.move-selection(delta); }
                    expand-selection => { root.expand-selection(); }
                    collapse-selection => { root.collapse-selection(); }
                    activate-selection => { root.activate-selection(); }
                    add-account => { root.open-details(); root.add-account(); }
                }

                // Draggable divider
                if root.sidebar-visible && !root.compact: Rectangle {
                    x: tree.width;
                    y: 0;
                    height: parent.height;
                    width: 1px;
                    background: Theme.border;
                    divider := TouchArea {
                        x: -3px;
                        width: 7px;
                        mouse-cursor: col-resize;
                        moved => {
                            root.sidebar-width = max(220px, min(root.width - 380px, root.sidebar-width + self.mouse-x - self.pressed-x));
                        }
                    }
                }

                DetailsPane {
                    x: root.compact ? 0px : tree.width + (root.sidebar-visible ? 1px : 0px);
                    y: 0;
                    height: parent.height;
                    width: root.compact && !root.details-open ? 0px : parent.width - self.x;
                    visible: !root.compact || root.details-open;
                    mode: root.mode;
                    header: root.header;
                    sections: root.sections;
                    editing: root.editing;
                    dirty: root.dirty;
                    leave-pending: root.leave-pending;
                    totp-remaining: root.totp-remaining;
                    folders: root.folders;
                    folder-index: root.folder-index;
                    account: root.account;
                    unlock-error: root.unlock-error;
                    group: root.group;
                    unlock-focus-request: root.unlock-focus-request;
                    sign-in: root.sign-in;
                    summary: root.summary;
                    busy: root.busy;
                    item-types: root.item-types;
                    type-index: root.type-index;
                    pick-type(index) => { root.pick-type(index); }
                    ssh-visible: root.ssh-visible;
                    ssh-enabled: root.ssh-enabled;
                    ssh-mode: root.ssh-mode;
                    ssh-toggle(on) => { root.ssh-toggle(on); }
                    ssh-mode-picked(index) => { root.ssh-mode-picked(index); }
                    create-folder(name) => { root.create-folder(name); }
                    sign-in-submit(choice, url, email, password) => { root.sign-in-submit(choice, url, email, password); }
                    sign-in-code(provider, code, remember) => { root.sign-in-code(provider, code, remember); }
                    sign-in-email(provider) => { root.sign-in-email(provider); }
                    sign-in-cancel => { root.sign-in-cancel(); }
                    account-sync => { root.account-sync(); }
                    account-lock => { root.account-lock(); }
                    account-remove => { root.account-remove(); }
                    account-reconnect(password, code, remember) => { root.account-reconnect(password, code, remember); }
                    copy-field(s, f) => { root.copy-field(s, f); }
                    open-url(url) => { root.open-url(url); }
                    begin-edit => { root.begin-edit(); }
                    save => { root.save(); }
                    cancel => { root.cancel(); }
                    discard-and-leave => { root.discard-and-leave(); }
                    keep-editing => { root.keep-editing(); }
                    save-and-leave => { root.save-and-leave(); }
                    edit-field(s, f, text) => { root.edit-field(s, f, text); }
                    edit-label(s, f, text) => { root.edit-label(s, f, text); }
                    edit-name(text) => { root.edit-name(text); }
                    toggle-favorite => { root.toggle-favorite(); }
                    pick-folder(index) => { root.pick-folder(index); }
                    generate(s, f) => { root.generate(s, f); }
                    add-field(s) => { root.add-field(s); }
                    remove-field(s, f) => { root.remove-field(s, f); }
                    delete-item => { root.delete-item(); }
                    restore-item => { root.restore-item(); }
                    unlock(password) => { root.unlock(password); }
                }
            }
        }
    }

    // SSH agent approval prompt
    if root.ssh-prompt != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: 52px + root.safe-area-insets.top;
        width: min(560px, parent.width - 32px);
        height: prompt-layout.preferred-height;
        border-radius: Theme.radius;
        background: Theme.surface;
        border-width: 1px;
        border-color: Theme.honey;
        drop-shadow-blur: 18px;
        drop-shadow-color: #00000055;
        accessible-role: groupbox;
        accessible-label: "SSH agent request";

        prompt-layout := VerticalLayout {
            padding: 14px;
            spacing: 10px;
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: start;
                    Icon { source: Icons.terminal; width: 22px; height: 22px; tint: Theme.honey; }
                }
                Text {
                    text: root.ssh-prompt;
                    wrap: word-wrap;
                    color: Theme.text;
                    horizontal-stretch: 1;
                }
            }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                ActionButton { text: "Deny"; danger: true; clicked => { root.ssh-answer(false); } }
                ActionButton { text: "Allow"; primary: true; clicked => { root.ssh-answer(true); } }
            }
        }
    }

    // Another device asks to sign in; waits while an SSH prompt shows.
    if root.ssh-prompt == "": LoginRequestBanner {
        x: (parent.width - self.width) / 2;
        y: 52px + root.safe-area-insets.top;
        width: min(560px, parent.width - 32px);
    }

    // Toast
    if root.toast != "": Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 20px;
        width: toast-text.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: Theme.dark ? #f1efe9 : #26272d;
        drop-shadow-blur: 12px;
        drop-shadow-color: #00000040;
        toast-text := Text {
            text: root.toast;
            color: Theme.dark ? #1d1c1a : #f1efe9;
            font-size: Theme.body;
            accessible-role: text;
        }
    }

    // Holds text only while copy-to-clipboard runs.
    clip := TextInput {
        visible: false;
        width: 0px;
        height: 0px;
        single-line: false;
    }

    init => { scope.focus(); }
}
