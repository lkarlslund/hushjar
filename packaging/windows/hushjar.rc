// Windows resources: the icon shown by Explorer and the taskbar, and the
// version details shown in the file's properties. hushjar_version.h is
// written by crates/hushjar/build.rs.
#include "hushjar_version.h"
1 ICON "hushjar.ico"

1 VERSIONINFO
FILEVERSION 0,0,HUSHJAR_BUILD,0
PRODUCTVERSION 0,0,HUSHJAR_BUILD,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "Hushjar"
            VALUE "FileDescription", "Hushjar"
            VALUE "OriginalFilename", "hushjar.exe"
            VALUE "ProductVersion", HUSHJAR_VERSION
            VALUE "FileVersion", HUSHJAR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
